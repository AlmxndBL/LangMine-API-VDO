      "type": "hyperframes:block",
      "target": "compositions/ai-chat-reveal.html"
    },
    {
      "name": "code-diff",
      "type": "hyperframes:block",
      "target": "compositions/code-diff.html"
    },
    {
      "name": "onboarding-stepper-flow",
      "type": "hyperframes:component",
      "target": "compositions/components/onboarding-stepper-flow.html"
    },
    {
      "name": "yt-feather-highlight",
      "type": "hyperframes:component",
      "target": "compositions/components/yt-feather-highlight.html"
    },
    {
      "name": "dart-cursor",
      "type": "hyperframes:component",
      "target": "compositions/components/dart-cursor.html"
    }
  ]
}
